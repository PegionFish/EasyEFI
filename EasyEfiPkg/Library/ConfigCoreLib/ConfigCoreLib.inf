## ConfigCoreLib — launcher.json 校验核心 + JSON DOM 双适配器之 EDK2 侧
## S03 实现（替换 S00 stub）。核心纯逻辑只认 DOM；JsonDomEdk2.c 是唯一 JsonLib 接触面。
## 宿主 jansson 适配器（JsonDomHost.c）不进 .inf，由 host.mk 编译。
[Defines]
  INF_VERSION    = 0x0001001b
  BASE_NAME      = ConfigCoreLib
  FILE_GUID      = 6FD59C5B-F07F-47FA-A478-895A8549EF89
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = ConfigCoreLib|UEFI_APPLICATION UEFI_DRIVER DXE_DRIVER

[Sources]
  ConfigCore.c
  JsonDom.c
  JsonDomEdk2.c

[Packages]
  MdePkg/MdePkg.dec
  RedfishPkg/RedfishPkg.dec
  EasyEfiPkg/EasyEfiPkg.dec

[LibraryClasses]
  EfiCompatLib
  ExecPathLib
  JsonLib
  BaseLib
  PcdLib

[Pcd]
  gEasyEfiPkgTokenSpaceGuid.PcdSkipTimeoutDefault

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -DUEFI_BUILD