## ExecVolumeLib — FsOps 双后端 + 卷枚举 + P3 发现（S09 真实实现）
## POSIX 后端（FsPosixBackend.c）仅宿主编译（host.mk），不进本 .inf。
## VolumeModelLib 依赖：S05 合入前经 module.dsc.inc 作用域覆盖解析到
## VolumeModelInterim（S09 临时自供）；合入后移除覆盖即回全局真实解析。
[Defines]
  INF_VERSION    = 0x0001001b
  BASE_NAME      = ExecVolumeLib
  FILE_GUID      = 77EE7085-5601-45A9-A842-6C4C9729265A
  MODULE_TYPE    = BASE
  VERSION_STRING = 0.1
  LIBRARY_CLASS  = ExecVolumeLib|UEFI_APPLICATION UEFI_DRIVER DXE_DRIVER

[Sources]
  FsCommon.c
  FsUefiBackend.c
  VolUefi.c

[Packages]
  MdePkg/MdePkg.dec
  EasyEfiPkg/EasyEfiPkg.dec

[LibraryClasses]
  EfiCompatLib
  BaseLib
  BaseMemoryLib
  DevicePathLib
  UefiBootServicesTableLib
  VolumeModelLib

[Protocols]
  gEfiSimpleFileSystemProtocolGuid    ## CONSUMES
  gEfiLoadedImageProtocolGuid         ## CONSUMES
  gEfiDevicePathProtocolGuid          ## CONSUMES
  gEfiPartitionInfoProtocolGuid       ## CONSUMES

[Guids]
  gEfiFileInfoGuid                    ## CONSUMES
  gEfiFileSystemInfoGuid              ## CONSUMES
  gEfiPartTypeSystemPartGuid          ## CONSUMES（ESP 类型 GUID，FsName 启发式）

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -DUEFI_BUILD
