## TEMPORARY（S09 workaround，leader 修复 EfiMem.c 后删除）：
## main 84c6f4c 的 EfiCompatLib/EfiMem.c 使用 ASSERT 但未 include <Library/DebugLib.h>，
## 应用模块编译该实例时 -Werror=implicit-function-declaration 失败（S09 首个应用构建实证；
## 库模块单独构建不编译依赖实例故未暴露）。本 wrapper 不复制代码——直接编译 leader 的
## EfiMem.c，经 .inf BuildOptions 强制包含 DebugLib.h。仅经 module.dsc.inc 作用域覆盖
## 解析给 S09 自己的组件，不影响全局 EfiCompatLib 解析。
[Defines]
  INF_VERSION    = 0x0001001b
  BASE_NAME      = EfiCompatLibS09
  FILE_GUID      = E1368E7D-D8F4-4147-9BE7-624D4740705D
  MODULE_TYPE    = BASE
  VERSION_STRING = 0.1
  LIBRARY_CLASS  = EfiCompatLib|UEFI_APPLICATION UEFI_DRIVER DXE_DRIVER

[Sources]
  ../EfiCompatLib/EfiMem.c

[Packages]
  MdePkg/MdePkg.dec
  EasyEfiPkg/EasyEfiPkg.dec

[LibraryClasses]
  MemoryAllocationLib
  BaseMemoryLib
  DebugLib

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -DUEFI_BUILD -include Library/DebugLib.h
