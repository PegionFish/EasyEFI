## TEST-ONLY：S09 ExecVolumeLib 契约替身（VolEnumerate/VolFree + Info-only FS_OPS），
## S10 冒烟专用。集成时由真实 ExecVolumeLib 取代；不进 EasyEfiPkg 聚合器。
[Defines]
  INF_VERSION    = 0x0001001b
  BASE_NAME      = SmokeExecVolumeLib
  FILE_GUID      = 1D5AD376-270F-4B27-8A10-AF2ED35C5074
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = ExecVolumeLib|UEFI_APPLICATION UEFI_DRIVER DXE_DRIVER

[Sources]
  UefiVolFixture.c

[Packages]
  MdePkg/MdePkg.dec
  EasyEfiPkg/EasyEfiPkg.dec

[LibraryClasses]
  BaseMemoryLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  DevicePathLib
  EfiCompatLib

[Protocols]
  gEfiSimpleFileSystemProtocolGuid
  gEfiDevicePathProtocolGuid

[Guids]
  gEfiFileInfoGuid
  gEfiFileSystemInfoGuid

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -DUEFI_BUILD