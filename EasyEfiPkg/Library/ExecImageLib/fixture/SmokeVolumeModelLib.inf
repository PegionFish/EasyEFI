## TEST-ONLY：S05 VolumeModelLib 契约替身（仅 VolSameDisk），S10 冒烟专用。
## 集成时由真实 VolumeModelLib 取代；不进 EasyEfiPkg 聚合器。
[Defines]
  INF_VERSION    = 0x0001001b
  BASE_NAME      = SmokeVolumeModelLib
  FILE_GUID      = E8A01C1A-62EF-4447-8133-AB1562B2E5A4
  MODULE_TYPE    = BASE
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = VolumeModelLib|UEFI_APPLICATION UEFI_DRIVER DXE_DRIVER

[Sources]
  VolModelFixture.c

[Packages]
  MdePkg/MdePkg.dec
  EasyEfiPkg/EasyEfiPkg.dec

[LibraryClasses]
  EfiCompatLib

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -DUEFI_BUILD