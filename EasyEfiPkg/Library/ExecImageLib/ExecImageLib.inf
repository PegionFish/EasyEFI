## ExecImageLib —— ExecOps 真实后端（S10；BASE_NAME/LIBRARY_CLASS 保持 S00 不变）
[Defines]
  INF_VERSION    = 0x0001001b
  BASE_NAME      = ExecImageLib
  FILE_GUID      = A9333908-0D97-427A-A456-EA2956349C31
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = ExecImageLib|UEFI_APPLICATION UEFI_DRIVER DXE_DRIVER

[Sources]
  ExecImage.c
  ExecImageUefi.c

[Packages]
  MdePkg/MdePkg.dec
  EasyEfiPkg/EasyEfiPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  DevicePathLib
  EfiCompatLib
  VolumeModelLib
  ExecVolumeLib

[Protocols]
  gEfiLoadedImageProtocolGuid
  gEfiDevicePathProtocolGuid

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -DUEFI_BUILD