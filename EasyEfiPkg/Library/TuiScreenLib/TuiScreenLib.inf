## TuiScreenLib — ConOut 屏幕缓冲真实后端（S06 替换 S00 stub）
## MODULE_TYPE 由 BASE 升为 UEFI_DRIVER：依赖 UefiBootServicesTableLib（gST）。
## BASE_NAME / LIBRARY_CLASS 保持不变（契约消费方：UEFI_APPLICATION/UEFI_DRIVER/DXE_DRIVER）。
[Defines]
  INF_VERSION    = 0x0001001b
  BASE_NAME      = TuiScreenLib
  FILE_GUID      = 4BA86384-7018-437B-9B81-BA8532F84C8E
  MODULE_TYPE    = UEFI_DRIVER
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = TuiScreenLib|UEFI_APPLICATION UEFI_DRIVER DXE_DRIVER

[Sources]
  TuiScreen.c
  TuiScreenUefi.c

[Packages]
  MdePkg/MdePkg.dec
  EasyEfiPkg/EasyEfiPkg.dec

[LibraryClasses]
  EfiCompatLib
  UefiBootServicesTableLib

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -DUEFI_BUILD
