## Editor — S13 脚本导向文本编辑器（core+glue；design §7.3 MVP 范围冻结）
[Defines]
  INF_VERSION    = 0x0001001b
  BASE_NAME      = Editor
  FILE_GUID      = 2F88E5D3-4380-4796-B528-D74FD392732D
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 0.1
  ENTRY_POINT    = UefiMain

[Sources]
  EditorCore.c
  EditorGlue.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  EasyEfiPkg/EasyEfiPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib
  PrintLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  DevicePathLib
  PcdLib
  EfiCompatLib
  EditorModelLib
  Utf8Lib
  TuiScreenLib
  TuiInputLib
  ExecVolumeLib

[Protocols]
  gEfiShellProtocolGuid
  gEfiShellParametersProtocolGuid
  gEfiLoadedImageProtocolGuid

[Guids]
  ## S09 VolUefi.c 引用但 ExecVolumeLib.inf 未声明（S09 缺口，已报 leader）；
  ## 消费模块声明以生成定义，保证链接。S09 修复后本行可留可删。
  gEfiPartTypeSystemPartGuid

[Pcd]
  gEasyEfiPkgTokenSpaceGuid.PcdEditorMaxFileSize
  gEasyEfiPkgTokenSpaceGuid.PcdUndoDepth

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -DUEFI_BUILD
