## Launcher — 启动菜单应用（S11 真实实现：core 状态机 + UEFI glue）
[Defines]
  INF_VERSION    = 0x0001001b
  BASE_NAME      = Launcher
  FILE_GUID      = 73DE1BA1-D939-4D37-B0F5-19DF80D7BE4B
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0
  ENTRY_POINT    = UefiMain

[Sources]
  LauncherCore.c
  LauncherGlue.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  RedfishPkg/RedfishPkg.dec
  EasyEfiPkg/EasyEfiPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  PrintLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  DevicePathLib
  PcdLib
  JsonLib
  EfiCompatLib
  TuiScreenLib
  TuiInputLib
  ConfigCoreLib
  ExecPathLib
  ExecVolumeLib
  ExecImageLib
  VolumeModelLib

[Protocols]
  gEfiShellProtocolGuid
  gEfiLoadedImageProtocolGuid

[Guids]
  gEfiGlobalVariableGuid
  ## 工作区临时声明：S09 VolUefi.c 使用但 ExecVolumeLib.inf [Guids] 漏列（已报 leader，
  ## S09 修复后本行可移除）。消费模块 AutoGen 定义该 GUID 以解链接。
  gEfiPartTypeSystemPartGuid

[Pcd]
  gEasyEfiPkgTokenSpaceGuid.PcdSkipTimeoutDefault

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -DUEFI_BUILD
