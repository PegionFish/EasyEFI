## FileManager — 刷机导向文件管理器（S12；core 纯状态机 + glue UEFI 装配）
[Defines]
  INF_VERSION    = 0x0001001b
  BASE_NAME      = FileManager
  FILE_GUID      = F5FBFBBC-D5E5-491B-96E3-B3CB90AC9628
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0
  ENTRY_POINT    = UefiMain

[Sources]
  FileManagerGlue.c
  FmCore.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  EasyEfiPkg/EasyEfiPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib
  PrintLib
  BaseMemoryLib
  MemoryAllocationLib
  DevicePathLib
  PcdLib
  EfiCompatLib
  TuiScreenLib
  TuiInputLib
  ExecVolumeLib
  ExecImageLib

[Protocols]
  gEfiShellProtocolGuid
  gEfiLoadedImageProtocolGuid

[Guids]
  ## S09 ExecVolumeLib.inf [Guids] 缺此 GUID（VolUefi.c 使用）；消费模块暂自声明，
  ## 建议 S09 补进库 .inf（见 docs/handoffs/S12.md 集成注意）
  gEfiPartTypeSystemPartGuid          ## CONSUMES

[Pcd]
  gEasyEfiPkgTokenSpaceGuid.PcdPreviewMaxBytes    ## CONSUMES

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -DUEFI_BUILD
